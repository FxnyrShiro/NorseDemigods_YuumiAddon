<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <AssemblyName>YuumiAddon</AssemblyName>
    <RootNamespace>YuumiAddon</RootNamespace>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <Version>1.0.0</Version>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
  </PropertyGroup>

  <PropertyGroup>
    <ValheimManaged>/home/fxnyrshiro/.local/share/Steam/steamapps/common/Valheim/valheim_Data/Managed</ValheimManaged>
    <BepInExCore>/home/fxnyrshiro/.config/r2modmanPlus-local/Valheim/profiles/Default/BepInEx/core</BepInExCore>
